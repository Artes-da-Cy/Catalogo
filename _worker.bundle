function validCategory(category) {
  return category && validId(category.id) && typeof category.nome === "string" && category.nome.trim().length > 0 && typeof category.descricao === "string" && validImageUrl(category.imagem, "categories") && Number.isInteger(category.ordem) && category.ordem >= 0;
}
