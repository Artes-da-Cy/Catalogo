async function onRequestPut(context) {
  const unauthorized = await requireAdmin(context);
  if (unauthorized) return unauthorized;
  if (!hasSameOrigin(context.request)) {
    return jsonResponse({ error: "Origem da solicita\xE7\xE3o n\xE3o autorizada." }, 403);
  }
  const category = await readJson(context.request);
  const originalId = new URL(context.request.url).searchParams.get("id");
  if (!validId(originalId) || !validCategory(category)) {
    return jsonResponse({ error: "Dados de categoria inv\xE1lidos." }, 400);
  }
  try {
    const result = await context.env.DB.prepare(`
      UPDATE categories
      SET id = ?, name = ?, description = ?, image = ?, display_order = ?,
          active = ?
      WHERE id = ?
    `).bind(
      category.id,
      category.nome.trim(),
      category.descricao.trim(),
      category.imagem.trim(),
      category.ordem,
      toBoolean(category.ativa),
      originalId
    ).run();
    if (result.meta.changes === 0) {
      return jsonResponse({ error: "Categoria n\xE3o encontrada." }, 404);
    }
    return jsonResponse({ id: category.id });
  } catch (error) {
    return jsonResponse({ error: errorMessage(error) }, 409);
  }
}
__name(onRequestPut, "onRequestPut");
async function onRequestDelete(context) {
  const unauthorized = await requireAdmin(context);
  if (unauthorized) return unauthorized;
  if (!hasSameOrigin(context.request)) {
    return jsonResponse({ error: "Origem da solicita\xE7\xE3o n\xE3o autorizada." }, 403);
  }
  const id = new URL(context.request.url).searchParams.get("id");
  if (!validId(id)) {
    return jsonResponse({ error: "Identificador de categoria inv\xE1lido." }, 400);
  }
  try {
    const productCount = await context.env.DB.prepare(`
      SELECT COUNT(*) AS quantity
      FROM products
      WHERE category_id = ?
    `).bind(id).first();
    if (!productCount) {
      return jsonResponse({
        error: "N\xE3o foi poss\xEDvel verificar os produtos desta categoria."
      }, 500);
    }
    const quantity = Number(productCount.quantity);
    if (quantity > 0) {
      const message = quantity === 1 ? "Exclua o produto ou altere a categoria dele primeiro." : "Exclua os produtos ou altere a categoria deles primeiro.";
      const noun = quantity === 1 ? "produto vinculado" : "produtos vinculados";
      return jsonResponse({
        error: `N\xE3o \xE9 poss\xEDvel excluir esta categoria: h\xE1 ${quantity} ${noun}. ${message}`
      }, 409);
    }
    const result = await context.env.DB.prepare(
      "DELETE FROM categories WHERE id = ?"
    ).bind(id).run();
    if (result.meta.changes === 0) {
      return jsonResponse({ error: "Categoria n\xE3o encontrada." }, 404);
    }
    return jsonResponse({ id });
  } catch (error) {
    return jsonResponse({ error: errorMessage(error) }, 409);
  }
}
__name(onRequestDelete, "onRequestDelete");

